name: Morning Briefing

on:
  # Actions-cron laeuft in UTC und startet oft 10-20 Min spaeter.
  # Wir feuern breit um die deutsche 08:00-Zeit herum; das Python-Skript
  # laesst nur den Lauf durch, der wirklich in die lokale 08:00-Stunde faellt.
  #   Winter (UTC+1): 08:00 lokal = 07:00 UTC
  #   Sommer (UTC+2): 08:00 lokal = 06:00 UTC
  schedule:
    - cron: "45 6 * * *"   # ~08:45 Winter-Toleranz / 07:45 wird vom Skript geblockt
    - cron: "45 5 * * *"   # Sommer-Fenster
  # Manuelles Ausloesen per Knopf (immer erlaubt, umgeht das Zeitfenster).
  workflow_dispatch:

# Rechte fuers Pages-Deployment.
permissions:
  contents: read
  pages: write
  id-token: write

# Nie zwei Deployments gleichzeitig.
concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Abhaengigkeiten
        run: |
          python -m pip install --upgrade pip
          pip install requests google-api-python-client google-auth-oauthlib google-auth-httplib2

      - name: Briefing generieren
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          GOOGLE_TOKEN:      ${{ secrets.GOOGLE_TOKEN }}
          GOOGLE_CREDENTIALS: ${{ secrets.GOOGLE_CREDENTIALS }}
          PAGES_URL:         ${{ vars.PAGES_URL }}
          BRIEFING_MODEL:    "claude-sonnet-4-5"
          BRIEFING_TZ:       "Europe/Berlin"
          # Bei manuellem Start das Zeitfenster umgehen:
          FORCE_RUN:         ${{ github.event_name == 'workflow_dispatch' && '1' || '0' }}
        run: python generate_briefing.py

      - name: Pages konfigurieren
        uses: actions/configure-pages@v5

      - name: Artifact hochladen
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./public

      - name: Auf GitHub Pages deployen
        id: deployment
        uses: actions/deploy-pages@v4
