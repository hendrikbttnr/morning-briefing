name: Morning Briefing

on:
  schedule:
    - cron: "45 6 * * *"   # Winter-Fenster (08:00 lokal ~ 07:00 UTC, mit Toleranz)
    - cron: "45 5 * * *"   # Sommer-Fenster
  workflow_dispatch:

permissions:
  contents: write          # noetig, um die aktualisierte .ics zurueck ins Repo zu committen
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Python einrichten
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Abhaengigkeiten
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Briefing generieren + ICS pflegen
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          PAGES_URL:         ${{ vars.PAGES_URL }}
          BRIEFING_MODEL:    "claude-sonnet-4-5"
          BRIEFING_TZ:       "Europe/Berlin"
          FORCE_RUN:         ${{ github.event_name == 'workflow_dispatch' && '1' || '0' }}
        run: python generate_briefing.py

      - name: Aktualisierte ICS ins Repo zurueckschreiben
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          # Nur committen, wenn sich die ICS wirklich geaendert hat
          if [ -n "$(git status --porcelain public/briefing.ics)" ]; then
            git add public/briefing.ics
            git commit -m "Update briefing.ics ($(date -u +%Y-%m-%d))"
            git push
          else
            echo "Keine ICS-Aenderung – nichts zu committen (Lauf ausserhalb Zeitfenster)."
          fi

      - name: Pages konfigurieren
        uses: actions/configure-pages@v5

      - name: Artifact hochladen
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./public

      - name: Auf GitHub Pages deployen
        id: deployment
        uses: actions/deploy-pages@v4
